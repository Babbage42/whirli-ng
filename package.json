{
  "name": "whirli-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve --hmr",
    "build": "ng build",
    "build:lib": "ng build whirli-ng",
    "build:playground:pages": "ng build",
    "watch": "ng build --watch --configuration development",
    "watch:lib": "ng build whirli-ng --watch --configuration development",
    "test": "npx jest && npm run test:e2e && npm run test:e2e:ssr",
    "serve:ssr:playground": "node dist/whirli-playground/server/server.mjs",
    "test:e2e:ssr": "playwright test -c e2e/playwright.ssr.config.ts",
    "storybook": "ng run whirli-ng:storybook",
    "build-storybook": "ng run whirli-ng:build-storybook",
    "prepare": "husky",
    "test:e2e": "npm run build-storybook && playwright test -c e2e/playwright.config.ts"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2200.0",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@compodoc/compodoc": "^1.1.26",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-docs": "^10.4.3",
    "@storybook/addon-onboarding": "^10.4.3",
    "@storybook/angular": "^10.4.3",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.18.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^16.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.0.0",
    "storybook": "^10.4.3",
    "ts-jest": "^29.4.5",
    "typescript": "~6.0.3"
  }
}
